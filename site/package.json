{
  "name": "skills-catalog-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:index": "node scripts/build-skills-index.mjs",
    "validate:evals": "node scripts/validate-evals.mjs",
    "predev": "npm run build:index",
    "dev": "next dev",
    "prebuild": "npm run build:index",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run build:index",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "gray-matter": "^4.0.3",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/archiver": "^6.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
